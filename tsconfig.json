{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmitOnError": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "rootDir": "src",
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": false,
        "skipLibCheck": true,
        "lib": ["ES2020", "DOM"]
    },
    "include": ["src/**/*.js"],
    "exclude": ["node_modules", "dist", "test"]
}
