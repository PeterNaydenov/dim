{
  "name": "@peter.naydenov/dim",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "author": "Peter Naydenov",
  "description": "Lightweight library that creates invisible DOM markers for defining ranges, inserting, replacing, and undoing content in place.",
  "keywords": [
    "dom",
    "range",
    "marker",
    "invisible",
    "editable-region",
    "content-slot"
  ],
  "homepage": "https://github.com/PeterNaydenov/dim#readme",
  "bugs": "https://github.com/PeterNaydenov/dim/issues",
  "repository": "https://github.com/PeterNaydenov/dim.git",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "Changelog.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "main": "dist/dim.cjs",
  "module": "dist/dim.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/dim.js",
      "require": "./dist/dim.cjs",
      "types": "./dist/main.d.ts"
    },
    "./umd": "./dist/dim.umd.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build:types": "tsc",
    "build:js": "vite build",
    "build": "npm run build:js && npm run build:types",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "cover": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck  && npm run build"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
