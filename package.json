{
  "name": "@peter.naydenov/dim",
  "version": "1.1.1",
  "type": "module",
  "license": "MIT",
  "author": "Peter Naydenov",
  "description": "Lightweight library that creates invisible DOM markers for defining ranges, inserting, replacing, and undoing content in place.",
  "keywords": [
    "dom",
    "range",
    "marker",
    "invisible",
    "editable-region",
    "content-slot"
  ],
  "homepage": "https://github.com/PeterNaydenov/dim#readme",
  "bugs": "https://github.com/PeterNaydenov/dim/issues",
  "repository": "https://github.com/PeterNaydenov/dim.git",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    ".agents/skills/peter-naydenov-dim",
    "README.md",
    "Changelog.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "main": "dist/dim.cjs",
  "module": "dist/dim.js",
  "types": "dist/main.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/dim.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/dim.cjs"
      }
    },
    "./umd": {
      "types": "./dist/main.d.cts",
      "default": "./dist/dim.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build:types": "tsc6 && node scripts/make-cts.js",
    "build:js": "vite build",
    "build": "npm run build:js && npm run build:types",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cover": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "agents": {
    "skills": [
      {
        "name": "peter-naydenov-dim",
        "path": ".agents/skills/peter-naydenov-dim",
        "description": "Use @peter.naydenov/dim — invisible DOM markers for editable ranges. Triggers on content-slot, hot-swap, A/B-test, undo-able editor zone, and similar Range-based UI work."
      }
    ]
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
